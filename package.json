{
  "name": "headsmith",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Chrome extension for adding, rewriting and removing HTTP headers, organised into profiles and scoped by URL filters.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:update-fixtures": "UPDATE_FIXTURES=true vitest run",
    "pretest:e2e": "npm run build && node scripts/make-granted-build.mjs",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "guard": "npm run guard:core && npm run guard:egress && npm run guard:manifest && npm run guard:refs && npm run guard:locales && npm run guard:paths",
    "guard:core": "node scripts/guard-core-purity.mjs",
    "guard:egress": "node scripts/guard-egress.mjs",
    "guard:manifest": "node scripts/guard-manifest.mjs",
    "guard:refs": "node scripts/guard-manifest-refs.mjs",
    "guard:locales": "node scripts/guard-locales.mjs",
    "guard:paths": "node scripts/guard-build-paths.mjs",
    "verify": "node scripts/verify-reproducible.mjs",
    "sbom": "cyclonedx-npm --output-format JSON --output-file build/headsmith-sbom.cdx.json --omit dev",
    "echo": "node scripts/echo-server.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
